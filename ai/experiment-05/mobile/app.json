{
  "expo": {
    "name": "Visual AI Assistant",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hcs-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/images/hcs-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/images/hcs-logo.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can choose an image for AI analysis.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera so you can photograph a receipt or document.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0E11"
  }
}
