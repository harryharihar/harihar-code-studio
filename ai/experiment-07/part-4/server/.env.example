OPENAI_API_KEY=your-key-here
# The model that runs the agent. Must support tools + Structured Outputs.
AGENT_MODEL=gpt-6-luna
PORT=3007
# Part 4: where the agent keeps its memory. Leave it out and the server forgets everything on restart.
DATABASE_URL=postgres://localhost:5432/mission_control
