{
  "expo": {
    "name": "Mission Control",
    "slug": "mission-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hcs-logo.png",
    "scheme": "missioncontrol",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F0E4",
    "ios": { "bundleIdentifier": "com.hariharcodestudio.missioncontrol" },
    "android": {
      "package": "com.hariharcodestudio.missioncontrol",
      "adaptiveIcon": { "backgroundColor": "#F6F1E7", "foregroundImage": "./assets/images/hcs-logo.png" }
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#F6F0E4", "image": "./assets/images/hcs-logo.png", "imageWidth": 160 }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
