OPENAI_API_KEY=your-key-here
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Must support Structured Outputs (json_schema)
ASSISTANT_MODEL=gpt-6-luna
PORT=3006
# Part 3 (optional) — defaults: gpt-4o-mini-tts, voice coral (female)
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=coral
# Part 5 — live conversation (WebRTC)
REALTIME_MODEL=gpt-realtime-2.1
# Female voices: marin (best), coral, shimmer, sage · Male: cedar, ash, echo, verse
REALTIME_VOICE=marin
